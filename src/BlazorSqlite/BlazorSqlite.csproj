<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Description>
      BlazorSqlite core: the ADO.NET surface, the worker transport (storage selection, engine-build
      negotiation, framing, batching, lifecycle), the storage provider contract, the in-memory
      reference backend, the EF Core integration (UseBlazorSqlite() on the stock SQLite provider), and
      the browser half - worker host, SQLite engine builds, and the JavaScript API storage providers'
      VFSes extend. Static assets are served under _content/BlazorSqlite.
    </Description>

    <!-- Static assets only; no Razor components, so no need to scan for them. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <Import Project="engine\wa-sqlite.lock.props" />
  <Import Project="engine\FetchEngine.targets" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.JSInterop" />

    <!-- Core, not the full Sqlite package: WASM must not pull in a native e_sqlite3. Desktop tests
         get a real engine through BlazorSqlite.Testing → Microsoft.Data.Sqlite. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorSqlite.Interop.Tests" />
  </ItemGroup>

</Project>
