<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Test support for BlazorSqlite: an in-process ISqliteTransport backed by Microsoft.Data.Sqlite so
      the stack can be unit-tested without a browser, and the conformance kit every storage provider
      must pass - inherit the test classes in your provider's test project and supply your provider.
    </Description>

    <PackageTags>$(PackageTags);testing;xunit;conformance;test-kit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />

    <!-- The conformance kit is a library of tests other projects inherit, not a runnable test
         project, so it takes the extensibility packages rather than the runner. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorSqlite\BlazorSqlite.csproj" />
  </ItemGroup>

</Project>
