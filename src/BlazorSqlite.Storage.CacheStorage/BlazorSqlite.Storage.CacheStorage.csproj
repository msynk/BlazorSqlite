<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Description>
      Cache Storage for BlazorSqlite. Block-based, journal-committed, and the besql migration path.
    </Description>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>

    <PackageTags>$(PackageTags);cache-storage;besql;storage;migration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.JSInterop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorSqlite\BlazorSqlite.csproj" />
  </ItemGroup>

</Project>
