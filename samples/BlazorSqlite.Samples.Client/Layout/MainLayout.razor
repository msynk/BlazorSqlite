@inherits LayoutComponentBase
@using BlazorSqlite.Samples.Client.Components
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

<div class="shell">
    <header class="top">
        <a class="brand" href="">
            <span class="brand-mark">SQL</span>
            <span>
                <span class="eyebrow">BlazorSqlite</span>
                <span class="brand-title">EF Core + SQLite, in this tab</span>
            </span>
        </a>
        <div class="top-right">
            <nav>
                <NavLink href="" Match="NavLinkMatch.All">Overview</NavLink>
                <span class="nav-sep"></span>
                <NavLink href="catalog">Catalog</NavLink>
                <NavLink href="customers">Customers</NavLink>
                <NavLink href="orders">Orders</NavLink>
                <span class="nav-sep"></span>
                <NavLink href="queries">SQL</NavLink>
                <NavLink href="storage">Storage</NavLink>
                <NavLink href="admin">Admin</NavLink>
                <NavLink href="limits">Limits</NavLink>
            </nav>
            <ThemeToggle />
        </div>
    </header>
    <StorageSwitcher />
    <main>
        <ErrorBoundary @ref="_boundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="exception">
                <UnhandledExceptionView Exception="exception" />
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    private ErrorBoundary? _boundary;

    protected override void OnParametersSet()
        => _boundary?.Recover();
}
