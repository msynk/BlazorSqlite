@page "/queries"
@inject BrowserDatabase Database

<SessionLifecycle OnReady="LoadAsync" OnTearDown="UnloadAsync" />

<p class="lead">
    SQL generation is the stock SQLite provider. BlazorSqlite only replaces the two services that
    assume synchronous I/O, and registers the same <code>ef_*</code> functions, <code>EF_DECIMAL</code>
    collation, and <code>regexp</code> that EF would have put on a real <code>SqliteConnection</code>.
</p>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

<section class="card">
    <h2>Live query with Include</h2>
    <p>
        Table-level: any write to a table the SQL reads re-runs the query. Open
        <a href="orders">Orders</a> in another tab and change a status - BroadcastChannel notifies
        this one. Customer is loaded with <code>Include</code>.
    </p>
    @if (_liveRows.Count == 0)
    {
        <p>No orders yet.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Number</th><th>Customer</th><th>Status</th><th>Ordered</th></tr></thead>
            <tbody>
            @foreach (var order in _liveRows)
            {
                <tr>
                    <td class="mono">@order.Number</td>
                    <td>@order.Customer?.DisplayName</td>
                    <td>@order.Status</td>
                    <td>@SampleFormat.When(order.OrderedAt)</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

<section class="card">
    <h2>Decimal compare</h2>
    <p>
        <code>decimal</code> is not a SQLite affinity. EF emits <code>ef_compare</code> and the
        collation <code>EF_DECIMAL</code>. Those run on 96-bit coefficients in the worker, not
        JavaScript numbers.
    </p>
    <form @onsubmit="FilterDecimalAsync" @onsubmit:preventDefault="true">
        <label>Credit limit ≥ <input @bind="_minCredit" type="number" step="0.01" /></label>
        <button type="submit" disabled="@(_busy || _context is null)">Run LINQ</button>
    </form>
    @if (_decimalSql is not null)
    {
        <h3>Generated SQL</h3>
        <pre>@_decimalSql</pre>
    }
    @if (_decimalRows is not null)
    {
        <p>@(_decimalRows.Count) customer(s).</p>
        <ul class="plain">
            @foreach (var customer in _decimalRows)
            {
                <li>@customer.DisplayName - @SampleFormat.Money(customer.CreditLimit)</li>
            }
        </ul>
    }
</section>

<section class="card">
    <h2>REGEXP</h2>
    <p>
        The worker registers <code>regexp</code> on every open. Pattern is JavaScript
        <code>RegExp</code> (lookaround and backreferences work).
    </p>
    <form @onsubmit="FilterRegexAsync" @onsubmit:preventDefault="true">
        <input @bind="_pattern" placeholder="Email REGEXP" />
        <button type="submit" disabled="@(_busy || _context is null)">Run SQL</button>
    </form>
    @if (_regexRows is not null)
    {
        <p>@(_regexRows.Count) row(s) matching <code>@_pattern</code>.</p>
        <ul class="plain">
            @foreach (var customer in _regexRows)
            {
                <li>@customer.DisplayName - @customer.Email</li>
            }
        </ul>
    }
</section>

<section class="card">
    <h2>ADO.NET on the same connection</h2>
    <p>
        The session exposes a <code>DbConnection</code>. Commands are async-only on this tier.
        This reads the engine version from wa-sqlite, not from a native <code>e_sqlite3</code>.
    </p>
    <button type="button" class="secondary" @onclick="ReadVersionAsync" disabled="@_busy">SELECT sqlite_version()</button>
    @if (_sqliteVersion is not null)
    {
        <p>sqlite_version() = <code>@_sqliteVersion</code></p>
    }
</section>

@code {
    private AppDbContext? _context;
    private ILiveQuery<IReadOnlyList<SalesOrder>>? _live;
    private IReadOnlyList<SalesOrder> _liveRows = [];
    private IReadOnlyList<Customer>? _decimalRows;
    private IReadOnlyList<Customer>? _regexRows;
    private string? _decimalSql;
    private string? _sqliteVersion;
    private string? _error;
    private decimal _minCredit = 10000m;
    private string _pattern = "northwind|alpine";
    private bool _busy;

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _context = await Database.OpenContextAsync();
            _live = _context.Orders
                .Include(o => o.Customer)
                .OrderByDescending(o => o.Id)
                .AsLiveQuery();
            _live.Changed += OnChanged;
            _liveRows = await _live.RefreshAsync();
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = ex.Message;
        }
    }

    private async Task UnloadAsync()
    {
        if (_live is not null)
        {
            _live.Changed -= OnChanged;
            await _live.DisposeAsync();
            _live = null;
        }

        if (_context is not null)
        {
            await _context.DisposeAsync();
            _context = null;
        }
    }

    private void OnChanged(object? sender, IReadOnlyList<SalesOrder> rows)
    {
        _liveRows = rows;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task FilterDecimalAsync()
    {
        if (_context is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var query = _context.Customers.AsNoTracking()
                .Where(c => c.CreditLimit >= _minCredit)
                .OrderBy(c => c.DisplayName);
            _decimalSql = query.ToQueryString();
            _decimalRows = await query.ToListAsync();
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task FilterRegexAsync()
    {
        if (_context is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _regexRows = await _context.Customers
                .FromSql($"SELECT * FROM \"Customers\" WHERE \"Email\" REGEXP {_pattern}")
                .AsNoTracking()
                .ToListAsync();
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReadVersionAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _sqliteVersion = Convert.ToString(await Database.ExecuteScalarAsync("SELECT sqlite_version()"));
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
