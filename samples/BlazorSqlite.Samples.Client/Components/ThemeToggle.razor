@inject IJSRuntime Js

@* System / light / dark. The chosen mode is stored in localStorage and re-applied before first
   paint by the boot script in index.html, so reloads never flash the wrong theme. *@
<div class="theme" role="group" aria-label="Colour theme">
    <button type="button" title="Follow the operating system"
            aria-pressed="@(_mode == "system")" @onclick='() => SetAsync("system")'>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="4" width="20" height="13" rx="2" />
            <path d="M8 21h8" />
        </svg>
        Auto
    </button>
    <button type="button" title="Always light" aria-label="Light theme"
            aria-pressed="@(_mode == "light")" @onclick='() => SetAsync("light")'>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
    </button>
    <button type="button" title="Always dark" aria-label="Dark theme"
            aria-pressed="@(_mode == "dark")" @onclick='() => SetAsync("dark")'>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
    </button>
</div>

@code {
    private string _mode = "system";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _mode = await Js.InvokeAsync<string>("blazorSqliteSample.theme.get");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
        }
    }

    private async Task SetAsync(string mode)
    {
        _mode = mode;
        try
        {
            await Js.InvokeAsync<string>("blazorSqliteSample.theme.set", mode);
        }
        catch (Exception ex)
        {
            SampleLog.Exception(ex);
        }
    }
}
