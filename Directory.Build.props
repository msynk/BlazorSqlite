<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Overrides inherit base documentation; requiring /// on every ADO.NET member is pure noise.
         Public API docs are enforced by review before the contract is published at 1.0. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <Authors>BlazorSqlite</Authors>
    <Product>BlazorSqlite</Product>
    <Company>BlazorSqlite</Company>
    <Copyright>Copyright (c) BlazorSqlite contributors</Copyright>
    <VersionPrefix>0.2.0</VersionPrefix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/msynk/BlazorSqlite</PackageProjectUrl>
    <RepositoryUrl>https://github.com/msynk/BlazorSqlite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor;webassembly;sqlite;wasm;efcore;entity-framework;opfs;indexeddb;offline;local-first</PackageTags>
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)/README.md')">README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
